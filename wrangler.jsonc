{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petra-ssite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Product database and image storage (CMS). Cloudflare creates these
  // automatically on the first deploy — no IDs needed.
  "d1_databases": [{ "binding": "DB", "database_name": "petra-ssite-db" }],
  "kv_namespaces": [{ "binding": "MEDIA" }],

  // Keep variables and secrets added in the Cloudflare dashboard between
  // deploys. The site password lives there (SITE_PASSWORD), not in this file.
  "keep_vars": true
}
